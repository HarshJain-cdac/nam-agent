# nam-agent settings. Copy to .env and fill in; every line is optional unless
# marked required. Never commit .env (it is git-ignored).

# --- The model ---------------------------------------------------------------
# The provider (nam_agent/loop/models.py PROVIDERS): openai for any
# OpenAI-compatible server (vLLM serving gpt-oss, for example), anthropic, ...
NAM_PROVIDER=openai
# The model server's address and key (required for a self-hosted server),
# e.g. http://<model-host>:8000/v1
NAM_BASE_URL=
NAM_API_KEY=
# The main model, and the small one (the intent and domain checks)
NAM_MODEL=
NAM_SMALL_MODEL=
# The model per NAM task, in the order tried: "domain=m1,m2; followup=m3"
# NAM_MODELS=
# NAM_LLM_TIMEOUT=120         seconds per model call
# NAM_TEMPERATURE=0
# NAM_SEED=7
# NAM_TOOL_MODE=auto          "text" when the server cannot do native tool calls
# NAM_MAX_ITERATIONS=10       tool calls per turn
# NAM_MAX_TOKENS=8192
# NAM_HISTORY_TURNS=12        turns of a chat sent to the model

# --- SAP and the knowledge graph --------------------------------------------
# The MCP server that reads SAP's PR, PO and service lines and the tender
# knowledge graph, e.g. http://<mcp-host>:8091/mcp (required: without it the
# NAM tools are not registered)
NAM_KG_URL=
# The tools the agent is given: SAP alone by default; "all" adds the KG tools
# NAM_KG_TOOLS=sap_search,nam
# The tender knowledge graph's precedent API (the kg_* tools)
# NAM_KG_API_URL=http://127.0.0.1:8077
# NAM_KG_TIMEOUT=120
# Where the scanned tender notices are (GET /api/tender/<case>/nit.pdf)
# NRL_CORPUS_ROOTS=/data2/nrl_dev/nrl_kg_data

# --- The flow ----------------------------------------------------------------
# NAM_CHAT=flow               "driver": the earlier need-capture driver
# NAM_DOMAIN_ONLY=            only procurement work is answered ("0" turns it off)
# NAM_CHAT_MEMORY=            shared memory across chats: off where NAM runs ("on" to share)
# NAM_STOP_AT=tender          how far the /api/nam/* screens lead a case ("pr": to the PR)
# NAM_SOURCE=                 "sap": the screens' need capture reads SAP
# NAM_FAST_GREETINGS=1        a bare greeting answered without a model call

# --- The server ----------------------------------------------------------------
# Every endpoint on one port (docs/backend-integration.md)
# NAM_HOST=127.0.0.1
# NAM_PORT=7777
# A shared secret the backend sends as "Authorization: Bearer <key>" on every
# /api/* and /v1/* call. Set it whenever NAM_HOST is not 127.0.0.1.
# python -c "import secrets; print(secrets.token_hex(32))"
NAM_SERVER_KEY=
# The browser origin allowed to call the API (CORS), e.g. https://procurix.nrl.local
# NAM_CORS_ORIGIN=*
# NAM_RATE=120                /v1/nam calls per user per minute (0: off)
# NAM_MAX_BODY=1048576        largest /v1/nam/run body, bytes
# NAM_MAX_DOC=26214400        largest document upload, bytes
# NAM_OCR_BACKEND=            "module:Class" for scanned pages
# NAM_OCR_MIN_CHARS=20

# --- State and tracing ---------------------------------------------------------
# Where the harness keeps state.db, the cases and the traces
# NAM_HOME=.nam
# OpenTelemetry spans (traces always land in $NAM_HOME/traces/*.jsonl)
# OTEL_EXPORTER_OTLP_ENDPOINT=
